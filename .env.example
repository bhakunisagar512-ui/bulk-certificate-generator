# ---- Copy to .env (setup.sh does this and generates secrets for you) ----
# development | production
ENVIRONMENT=development

# PostgreSQL (docker-compose builds DATABASE_URL for containers from these)
POSTGRES_USER=certgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=certgen
# Only used when running the app outside Docker:
DATABASE_URL=postgresql+psycopg://certgen:change-me@localhost:5432/certgen

REDIS_URL=redis://localhost:6379/0

# JWT (use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true

# Storage and public URL (used for the QR code on certificates)
STORAGE_DIR=./storage/certificates
PUBLIC_BASE_URL=http://localhost:8000

# Limits
MAX_RECIPIENTS=1000
MAX_BODY_BYTES=2097152
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOBS_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_VERIFY_PER_MINUTE=60

# Housekeeping
# 0 disables cleanup
RETENTION_DAYS=30
STUCK_TIMEOUT_SECONDS=300

# Optional: comma separated list of allowed browser origins (empty = no CORS)
CORS_ORIGINS=
ENABLE_DOCS=true
